<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mabure.daemon</string>
    <key>Program</key>
    <string>/usr/local/libexec/mabure/mabured</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/libexec/mabure/mabured</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>ProcessType</key>
    <string>Standard</string>
    <key>StandardOutPath</key>
    <string>/var/log/mabure/daemon.out.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/mabure/daemon.err.log</string>
    <key>Umask</key>
    <string>022</string>
    <key>ExitTimeOut</key>
    <integer>5</integer>
</dict>
</plist>
